# CineBook Environment Configuration
# Production: Set these in Vercel Project Settings > Environment Variables

# Neon Serverless PostgreSQL Database Connection (from Vercel Marketplace)
DATABASE_URL="postgresql://neondb_owner:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Alternative alias provided by Vercel Postgres integration:
POSTGRES_URL="postgresql://neondb_owner:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Vercel Cron Secret (Protects /api/cron/release-holds)
CRON_SECRET="cinebook_cron_secret_secure_token_xyz987"

# Authentication JWT Secret
AUTH_SECRET="cinebook_jwt_super_secret_signing_key_min_32_chars_2026"
NEXTAUTH_SECRET="cinebook_jwt_super_secret_signing_key_min_32_chars_2026"

# Next Public Site URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Vercel Blob Token for Image Uploads
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_token_sample"

# Test Payment Provider (Stripe Test / Simulated Gateway)
PAYMENT_PROVIDER_MODE="test"
